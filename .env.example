# Database
MONGODB_URI=mongodb://127.0.0.1:27017/tilcayo

# Authentication — generated in .env by tilcayo make:auth
AUTH_ACCESS_SECRET=
AUTH_REFRESH_SECRET=

# Password recovery (backend only)
MAIL_USER=
MAIL_PASS=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
# Optional: MAIL_FROM (defaults to MAIL_USER), MAIL_SECURE (inferred from port)
