{
  "name": "my-fullstack-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "workspaces": [
    "api",
    "client"
  ],
  "tilcayo": {
    "type": "fullstack",
    "auth": true,
    "admin": true,
    "packageManager": "npm",
    "tenancy": true
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace api",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace api",
    "routes": "npm run routes --workspace api",
    "seed:demo": "npm run build --workspace api && npm run seed:demo --workspace api",
    "seed:demo:remove": "npm run build --workspace api && npm run seed:demo --workspace api -- --remove",
    "tenancy:setup": "npm run build --workspace api && npm run tenancy:setup --workspace api"
  },
  "devDependencies": {
    "@tilcayo/cli": "file:../packages/cli"
  }
}
